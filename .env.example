# Get a free key at https://console.groq.com. Without it the API runs in offline demo mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# hash = no downloads (dev/tests), fastembed = real semantic embeddings (BAAI/bge-small-en-v1.5)
EMBEDDINGS=hash

# Leave empty for in-memory Qdrant; docker-compose sets this to the qdrant service.
QDRANT_URL=
TOP_K=4
MAX_RETRIES=1
CORS_ORIGINS=http://localhost:5173
